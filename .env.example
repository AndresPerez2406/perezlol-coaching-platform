# ==============================================================
# CONFIGURACIÓN DEL ENTORNO - PEREZLOL COACHING
# ==============================================================
# Copia este archivo a .env y completa con tus credenciales

# Supabase (Consigue estos datos en: Project Settings -> API en supabase.com)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta-opcional

# Riot Games API (Opcional, consigue tu clave en: https://developer.riotgames.com/)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_REGION=americas
RIOT_PLATFORM=la1
